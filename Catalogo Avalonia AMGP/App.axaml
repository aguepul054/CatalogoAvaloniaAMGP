<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Catalogo_Avalonia_AMGP.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <Style Selector="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Green"/>
            <Setter Property="BorderBrush" Value="Red"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background">
                <Setter.Value>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStops>
                                <GradientStop Color="#FF6B6B" Offset="0.0"/>
                                <GradientStop Color="#FF8E53" Offset="0.3"/>
                                <GradientStop Color="#FF5E3A" Offset="0.6"/>
                                <GradientStop Color="#4ECDC4" Offset="1.0"/>
                            </GradientStops>
                        </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Styles>
    <Application.Resources>
        <FontFamily x:Key="JapanDaisuki">avares://Catalogo Avalonia AMGP/Resources/Font/JapanDaisuki.otf#Japan Daisuki</FontFamily>
    </Application.Resources>
</Application>